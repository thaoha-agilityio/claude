{
  "permissions": {
    "allow": ["Bash(git status*)", "Bash(git diff*)", "Bash(git add *)", "Bash(git commit *)"],
    "deny": ["Bash(git push *)", "Bash(git reset *)", "Bash(git rebase *)"]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-forbidden-command.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
